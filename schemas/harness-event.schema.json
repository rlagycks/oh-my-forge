{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rlagycks/oh-my-forge/schemas/harness-event.schema.json",
  "title": "Oh My Forge Harness Event",
  "type": "object",
  "required": ["schema_version", "event_type", "ts", "source", "payload"],
  "properties": {
    "schema_version": { "const": 1 },
    "event_type": { "enum": ["context_injection", "task_outcome"] },
    "ts": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "episode_id": { "type": ["string", "null"] },
    "session_id": { "type": ["string", "null"] },
    "payload": { "type": "object" },
    "domain": { "type": "string" },
    "kinds": { "type": "object" },
    "chars": { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "context_injection" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["domain", "item_counts"],
            "properties": {
              "domain": { "type": "string", "minLength": 1 },
              "item_counts": { "type": "object" },
              "constraint_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "memory_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "constraint_id": { "type": "string", "minLength": 1 },
              "memory_id": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "const": "task_outcome" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["outcome"],
            "properties": {
              "outcome": { "enum": ["success", "failure", "unknown"] },
              "input_tokens": { "type": "integer", "minimum": 0 },
              "output_tokens": { "type": "integer", "minimum": 0 },
              "tool_calls": { "type": "integer", "minimum": 0 },
              "duration_ms": { "type": "integer", "minimum": 0 },
              "tests_passed": { "type": "boolean" },
              "human_intervention": { "type": "boolean" },
              "verification_exit_code": { "type": ["integer", "null"] },
              "expected_exit_code": { "type": "integer" },
              "timed_out": { "type": "boolean" },
              "error_code": { "type": ["string", "null"] },
              "recall_used": { "type": "boolean" },
              "condition": { "enum": ["on", "off"] },
              "harness_enabled": { "type": "boolean" },
              "repetition": { "type": "integer", "minimum": 1 },
              "seed": { "type": "integer", "minimum": 0 },
              "run_id": { "type": "string", "minLength": 1 },
              "task_hash": { "type": "string", "minLength": 1 },
              "snapshot_id": { "type": ["string", "null"] },
              "snapshot_hash": { "type": ["string", "null"] },
              "provider": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
              "config": { "type": "object" },
              "total_tokens": { "type": "integer", "minimum": 0 },
              "provider_duration_ms": { "type": "number", "minimum": 0 },
              "verification_duration_ms": { "type": "number", "minimum": 0 },
              "cost_usd": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
